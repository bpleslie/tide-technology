---
import Logo from './Logo.astro';

const links = [
  { href: '/#what-we-automate', label: 'What we automate' },
  { href: '/#how-we-work', label: 'How we work' },
  { href: '/casework', label: 'Casework' },
  { href: '/security', label: 'Security' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center" aria-label="Tide Technology Solutions home"><Logo /></a>

    <nav class="hidden lg:flex items-center gap-7 text-sm" aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['transition-colors hover:text-ink', isActive(l.href) ? 'text-ink font-medium' : 'text-muted']}
          aria-current={path === l.href ? 'page' : undefined}
        >{l.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary !py-2">Get in touch</a>
    </nav>

    <details class="lg:hidden relative group">
      <summary class="list-none cursor-pointer rounded-full border border-line px-4 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <nav class="absolute right-0 mt-2 w-60 rounded-2xl border border-line bg-surface p-2 shadow-xl" aria-label="Mobile">
        {links.map((l) => (
          <a href={l.href} class="block rounded-xl px-4 py-3 text-sm hover:bg-bg">{l.label}</a>
        ))}
        <a href="/contact" class="btn btn-primary mt-1 w-full">Get in touch</a>
      </nav>
    </details>
  </div>
</header>
