---
import Logo from './Logo.astro';

const links = [
  { href: '/vocational-consulting', label: 'Vocational consulting' },
  { href: '/law-firms', label: 'Law firms' },
  { href: '/security', label: 'Security' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" aria-label="Tide Technology Solutions home"><Logo /></a>

    <nav class="hidden md:flex items-center gap-7 text-sm" aria-label="Main">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={['transition-colors hover:text-ink', path === l.href ? 'text-ink font-medium' : 'text-muted']}
          aria-current={path === l.href ? 'page' : undefined}
        >{l.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary !py-2">Book a demo</a>
    </nav>

    <details class="md:hidden relative group">
      <summary class="list-none cursor-pointer rounded-full border border-line px-4 py-2 text-sm font-medium [&::-webkit-details-marker]:hidden">
        Menu
      </summary>
      <nav class="absolute right-0 mt-2 w-60 rounded-2xl border border-line bg-surface p-2 shadow-xl" aria-label="Mobile">
        {links.map((l) => (
          <a href={l.href} class="block rounded-xl px-4 py-3 text-sm hover:bg-bg">{l.label}</a>
        ))}
        <a href="/contact" class="btn btn-primary mt-1 w-full">Book a demo</a>
      </nav>
    </details>
  </div>
</header>
