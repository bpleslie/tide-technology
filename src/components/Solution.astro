---
import Base from '../layouts/Base.astro';
import CTA from './CTA.astro';

interface Item { title: string; body: string }
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  contextsLabel: string;
  contexts: string[];
  outputs: Item[];
  before: string[];
  after: string[];
}

const p = Astro.props;
---

<Base title={p.title} description={p.description}>
  <section class="container-page pt-20 sm:pt-28">
    <p class="eyebrow">{p.eyebrow}</p>
    <h1 class="mt-5 max-w-4xl text-5xl leading-[1.05] sm:text-6xl">{p.heading}</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">{p.intro}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/contact" class="btn btn-primary">Book a Casework demo</a>
      <a href="/casework" class="btn btn-ghost">About Casework</a>

    </div>
    <div class="mt-10">
      <p class="text-sm font-semibold">{p.contextsLabel}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {p.contexts.map((c) => <li class="rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-muted">{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="container-page mt-24">
    <p class="eyebrow">What you get</p>
    <h2 class="mt-4 max-w-2xl text-4xl">Work products your team reviews instead of builds.</h2>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {p.outputs.map((o) => (
        <div class="rounded-2xl border border-line bg-surface p-6">
          <h3 class="text-lg">{o.title}</h3>
          <p class="mt-2 text-sm text-muted">{o.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page mt-24 grid gap-6 md:grid-cols-2">
    <div class="rounded-3xl border border-line p-8">
      <p class="text-sm font-semibold text-muted">Without Casework</p>
      <ul class="mt-5 space-y-3">
        {p.before.map((b) => <li class="flex gap-3"><span class="text-muted" aria-hidden="true">–</span><span>{b}</span></li>)}
      </ul>
    </div>
    <div class="rounded-3xl border border-accent bg-accent-soft/60 p-8">
      <p class="text-sm font-semibold text-accent">With Casework</p>
      <ul class="mt-5 space-y-3">
        {p.after.map((a) => <li class="flex gap-3"><span class="text-accent" aria-hidden="true">✓</span><span>{a}</span></li>)}
      </ul>
    </div>
  </section>

  <CTA heading="See Casework on one of your cases" body="Book a 30-minute walkthrough. Bring a sample file and we’ll show you what the first draft looks like." cta="Book a Casework demo" />
</Base>
