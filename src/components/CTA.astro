---
interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'See it on one of your cases',
  body = 'Book a 30-minute walkthrough. Bring a sample file and we’ll show you what the first draft looks like.',
} = Astro.props;
---

<section class="container-page mt-24">
  <div class="rounded-3xl bg-deep px-6 py-14 text-center sm:px-12">
    <h2 class="text-3xl text-white sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-xl text-teal-100/80">{body}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/contact" class="btn bg-teal-300 text-teal-950 hover:bg-teal-200">Book a demo</a>
      <a href="mailto:brad@tide-technology.com" class="btn border border-white/25 text-white hover:bg-white/10">Email Brad</a>
    </div>
  </div>
</section>
