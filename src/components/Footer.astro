---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-24">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-4 font-serif text-lg text-ink">AI does the reading. Experts do the reasoning.</p>
      <p class="mt-2 text-sm text-muted">Agentic AI products and custom workflows for document-heavy professional work.</p>
    </div>
    <div>
      <p class="text-sm font-semibold">Products</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-ink" href="/casework">Casework</a></li>
        <li><a class="hover:text-ink" href="/casework/vocational-consulting">Casework for vocational consulting</a></li>
        <li><a class="hover:text-ink" href="/casework/law-firms">Casework for law firms</a></li>
        <li><a class="hover:text-ink" href="/#custom">Custom workflows</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">Company</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-ink" href="/about">About</a></li>
        <li><a class="hover:text-ink" href="/security">Security &amp; compliance</a></li>
        <li><a class="hover:text-ink" href="/contact">Contact</a></li>
        <li><a class="hover:text-ink" href="mailto:brad@tide-technology.com">brad@tide-technology.com</a></li>
      </ul>
    </div>
  </div>
  <div class="container-page border-t border-line py-6 text-xs text-muted">
    &copy; {year} Tide Technology Solutions. All rights reserved.
  </div>
</footer>
