---
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line sm:mt-24">
  <div class="container-page grid grid-cols-2 gap-x-6 gap-y-8 py-10 sm:py-14 md:grid-cols-[1.4fr_1fr_1fr] md:gap-10">
    <div class="col-span-2 max-w-sm md:col-span-1">
      <Logo />
      <p class="mt-4 font-serif text-lg text-ink">Put AI agents to work on the busywork.</p>
      <p class="mt-2 text-sm text-muted">Custom agentic AI workflows and products that help businesses run more efficiently.</p>
      <a class="mt-4 inline-block text-sm font-medium text-accent hover:underline" href="mailto:brad@tide-technology.com">brad@tide-technology.com</a>
    </div>
    <div>
      <p class="text-sm font-semibold">Products</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li>
          <a class="hover:text-ink" href="/casework">Casework</a>
          <ul class="mt-2 space-y-2 border-l border-line pl-3">
            <li><a class="hover:text-ink" href="/casework/vocational-consulting" aria-label="Casework for vocational consulting">Vocational consulting</a></li>
            <li><a class="hover:text-ink" href="/casework/law-firms" aria-label="Casework for law firms">Law firms</a></li>
          </ul>
        </li>
        <li><a class="hover:text-ink" href="/#what-we-automate">Custom workflows</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold">Company</p>
      <ul class="mt-3 space-y-2 text-sm text-muted">
        <li><a class="hover:text-ink" href="/about">About</a></li>
        <li><a class="hover:text-ink" href="/security">Security &amp; compliance</a></li>
        <li><a class="hover:text-ink" href="/contact">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="container-page border-t border-line py-5 text-xs text-muted sm:py-6">
    &copy; {year} Tide Technology Solutions. All rights reserved.
  </div>
</footer>
