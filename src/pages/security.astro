---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const sections = [
  {
    title: 'Built for HIPAA',
    body: 'Case files are full of protected health information. Tide is designed to meet HIPAA requirements for handling PHI, and we work with clients on Business Associate Agreements.',
  },
  {
    title: 'Your data stays yours',
    body: 'Client documents are used only to do your work. They are never used to train models, and they are never shared with other clients.',
  },
  {
    title: 'Open-weight models in private infrastructure',
    body: 'For the most sensitive processing, we run open-weight models in isolated, private environments, so documents never leave infrastructure under our control.',
  },
  {
    title: 'Frontier models, on your terms',
    body: 'Where frontier models add real value, we use them through enterprise agreements that match your data policies. You decide which workloads can use them.',
  },
  {
    title: 'Encryption and access control',
    body: 'Data is encrypted in transit and at rest. Access is role-based and limited to the people working the case.',
  },
  {
    title: 'Full audit trail',
    body: 'Every document, extraction, draft and approval is logged: who did what, when and based on which source pages.',
  },
];
---

<Base
  title="Security & compliance"
  description="How Tide Technology protects case files: built for HIPAA, open-weight models in private infrastructure, encryption, access controls, audit trails and expert review."
>
  <section class="container-page pt-20 sm:pt-28">
    <p class="eyebrow">Security &amp; compliance</p>
    <h1 class="mt-5 max-w-4xl text-5xl leading-[1.05] sm:text-6xl">Built for files you can’t afford to mishandle.</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Medical records, legal files and personal histories demand more than a chatbot. Tide is built around privacy,
      control and accountability from the ground up.
    </p>
  </section>

  <section class="container-page mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {sections.map((s) => (
      <div class="rounded-2xl border border-line bg-surface p-6">
        <h2 class="text-xl">{s.title}</h2>
        <p class="mt-2 text-sm text-muted">{s.body}</p>
      </div>
    ))}
  </section>

  <section class="container-page mt-24 grid gap-10 md:grid-cols-2 md:items-center">
    <div>
      <p class="eyebrow">Human in the loop</p>
      <h2 class="mt-4 text-4xl">AI prepares. Professionals decide.</h2>
    </div>
    <p class="text-lg text-muted">
      Tide never issues an opinion or sends a report on its own. Agents do the reading, organizing and drafting; a
      qualified expert reviews every output, checks the citations and makes the call. Accountability stays where it
      belongs.
    </p>
  </section>

  <CTA heading="Have security questions?" body="We’re happy to walk your team through our architecture, data handling and compliance posture." />
</Base>
