---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';
---

<Base
  title="About"
  description="Tide Technology Solutions builds agentic AI workflows for document-heavy professional work. Founded by Brad Leslie, a technology leader with 15+ years of experience building and scaling software."
>
  <section class="container-page pt-20 sm:pt-28">
    <p class="eyebrow">About Tide</p>
    <h1 class="mt-5 max-w-4xl text-5xl leading-[1.05] sm:text-6xl">Technology that gives experts their time back.</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Tide Technology Solutions builds agentic AI workflows for professionals whose work starts with a stack of documents. We
      believe AI should handle the reading, organizing and first drafts, and that judgment should stay with the experts
      who are accountable for it.
    </p>
  </section>

  <section class="container-page mt-20 grid gap-10 md:grid-cols-[300px_1fr] md:items-start">
    <img
      src="/brad-leslie.jpg"
      alt="Brad Leslie, founder of Tide Technology Solutions"
      width="900"
      height="900"
      loading="lazy"
      class="aspect-square w-56 rounded-3xl object-cover md:w-full"
    />
    <div>
      <h2 class="text-3xl">Brad Leslie</h2>
      <p class="mt-1 text-muted">Founder</p>
      <div class="mt-6 max-w-2xl space-y-4 text-lg text-muted">
        <p>
          Brad is a technology leader with more than 15 years of experience building and scaling software for
          high-growth businesses, from hands-on engineering to leading product and technology teams.
        </p>
        <p>
          He founded Tide Technology Solutions to build custom software that solves real operational problems, and today leads
          its focus on agentic AI: systems that take on the most time-consuming parts of document-heavy professional
          work while keeping experts firmly in control. Casework, for vocational consultants and law firms, is the first
          of a growing family of Tide products.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold">
        <a class="text-accent" href="https://www.linkedin.com/in/bpleslie" rel="noopener" target="_blank">LinkedIn →</a>
        <a class="text-accent" href="mailto:brad@tide-technology.com">brad@tide-technology.com</a>
      </div>
    </div>
  </section>

  <CTA />
</Base>
