---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import CTA from '../components/CTA.astro';

const trust = ['Human in the loop', 'Every fact cited', 'Built for HIPAA', 'Open-weight & frontier models'];

const steps = [
  {
    title: 'Upload the case file',
    body: 'Medical records, depositions, employment history, prior reports: hundreds or thousands of pages, in whatever order they arrived.',
  },
  {
    title: 'Agents read and organize',
    body: 'AI agents review every page, pull out the facts that matter, build timelines and flag conflicts between sources. Each fact links to the page it came from.',
  },
  {
    title: 'You get a first draft',
    body: 'A structured draft in your format and voice. You review, edit and sign off. Nothing leaves the workflow without an expert’s approval.',
  },
];

const principles = [
  {
    title: 'Cited, not guessed',
    body: 'Every extracted fact and drafted sentence points back to a source page, so you can check it in seconds instead of re-reading the file.',
  },
  {
    title: 'Expert in the loop',
    body: 'The system prepares; professionals decide. Opinions, conclusions and signatures stay with the people accountable for them.',
  },
  {
    title: 'The right model for the job',
    body: 'Open-weight models run in private infrastructure for sensitive work, and frontier models are used where they add real value, under your data policies.',
  },
  {
    title: 'Secure by design',
    body: 'Built for HIPAA and confidential client data: encryption in transit and at rest, access controls and a complete audit trail.',
  },
];
---

<Base
  title="Tide Technology"
  description="AI does the reading. Experts do the reasoning. Agentic document review and report preparation that saves vocational consultants and law firms hours on every case."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="container-page relative pt-20 pb-16 sm:pt-28">
      <p class="eyebrow">Agentic document review &amp; report preparation</p>
      <h1 class="mt-5 max-w-4xl text-5xl leading-[1.05] sm:text-6xl lg:text-7xl">
        AI does the reading.<br />
        <span class="italic text-accent">Experts do the reasoning.</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted">
        Tide Technology builds AI agents that review case files and prepare report drafts for vocational consultants and
        law firms. Your team gets hours back on every case and spends them on the judgment only they can provide.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="btn btn-primary">Book a demo</a>
        <a href="#how-it-works" class="btn btn-ghost">See how it works</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-muted">
        {trust.map((t) => (
          <li class="flex items-center gap-2">
            <svg viewBox="0 0 16 16" class="h-4 w-4 text-accent" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>
    <div class="container-page relative pb-8">
      <Pipeline />
    </div>
  </section>

  <!-- Problem -->
  <section class="container-page mt-24 grid gap-10 md:grid-cols-2 md:items-end">
    <div>
      <p class="eyebrow">The problem</p>
      <h2 class="mt-4 text-4xl sm:text-5xl">Your experts spend most of their day reading.</h2>
    </div>
    <p class="text-lg text-muted">
      Before anyone can form an opinion, someone has to work through hundreds of pages of records, transcripts and
      reports: summarizing, cross-referencing and copying facts into a template. It’s slow, it’s expensive, and it’s
      the part of the job that uses the least of your expertise.
    </p>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="container-page mt-24 scroll-mt-24">
    <p class="eyebrow">How it works</p>
    <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl">From case file to first draft, with you in control.</h2>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="rounded-2xl border border-line bg-surface p-6">
          <span class="font-serif text-3xl text-accent">0{i + 1}</span>
          <h3 class="mt-4 text-xl">{s.title}</h3>
          <p class="mt-2 text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Who it's for -->
  <section class="container-page mt-24">
    <p class="eyebrow">Who it’s for</p>
    <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl">Built for teams whose work starts with a stack of documents.</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <a href="/vocational-consulting" class="group rounded-3xl border border-line bg-surface p-8 transition-colors hover:border-accent">
        <h3 class="text-2xl">Vocational consultants</h3>
        <p class="mt-3 text-muted">
          Records review, work history, restrictions and transferable skills, organized and drafted so you can focus on
          the vocational opinion.
        </p>
        <span class="mt-6 inline-block text-sm font-semibold text-accent">For vocational consulting <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
      </a>
      <a href="/law-firms" class="group rounded-3xl border border-line bg-surface p-8 transition-colors hover:border-accent">
        <h3 class="text-2xl">Law firms</h3>
        <p class="mt-3 text-muted">
          Medical chronologies, deposition summaries and case-fact memos from discovery productions, with every point
          cited back to the record.
        </p>
        <span class="mt-6 inline-block text-sm font-semibold text-accent">For law firms <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
      </a>
    </div>
  </section>

  <!-- Principles -->
  <section class="container-page mt-24">
    <p class="eyebrow">Why Tide</p>
    <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl">AI you can put your name behind.</h2>
    <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2">
      {principles.map((p) => (
        <div class="border-t border-line pt-6">
          <h3 class="text-xl">{p.title}</h3>
          <p class="mt-2 text-muted">{p.body}</p>
        </div>
      ))}
    </div>
    <a href="/security" class="mt-10 inline-block text-sm font-semibold text-accent">Read about security &amp; compliance →</a>
  </section>

  <!-- Custom -->
  <section class="container-page mt-24">
    <div class="grid gap-8 rounded-3xl border border-line bg-surface p-8 md:grid-cols-[1.2fr_1fr] md:items-center sm:p-12">
      <div>
        <p class="eyebrow">Custom agentic workflows</p>
        <h2 class="mt-4 text-3xl sm:text-4xl">Different documents, same bottleneck?</h2>
      </div>
      <p class="text-muted">
        If your team reviews documents and writes reports from them, whether claims, compliance files or case records,
        we can build an agentic workflow around your process, your templates and your security requirements.
      </p>
    </div>
  </section>

  <CTA />
</Base>

<style>
  .hero-wash {
    position: absolute;
    inset: -20% -10% auto;
    height: 80%;
    background:
      radial-gradient(ellipse 50% 60% at 80% 20%, var(--accent-soft), transparent 70%),
      radial-gradient(ellipse 40% 50% at 10% 0%, var(--accent-soft), transparent 70%);
    opacity: 0.9;
  }
</style>
