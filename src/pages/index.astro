---
import Base from '../layouts/Base.astro';
import CTA from '../components/CTA.astro';

const trust = ['Human in the loop', 'Cited, verifiable output', 'Built for HIPAA', 'Open-weight & frontier models'];

const reading = ['Reviews every page', 'Extracts and cites the facts', 'Flags conflicts and gaps', 'Drafts the first version'];
const reasoning = ['Weighs the evidence', 'Forms the opinion', 'Edits, approves and signs'];

const principles = [
  {
    title: 'Cited, not guessed',
    body: 'Everything our agents produce traces back to its source, so experts can verify it in seconds instead of redoing the work.',
  },
  {
    title: 'Experts stay in charge',
    body: 'Our systems prepare; professionals decide. Opinions, conclusions and signatures stay with the people accountable for them.',
  },
  {
    title: 'The right model for the job',
    body: 'Open-weight models in private infrastructure for sensitive work, frontier models where they add real value, always under your data policies.',
  },
  {
    title: 'Secure by design',
    body: 'Built for HIPAA and confidential client data: encryption in transit and at rest, access controls and a complete audit trail.',
  },
];

const approach = [
  { title: 'Map the workflow', body: 'We sit with your team, follow a real case end to end and find where expert time goes to reading and rework.' },
  { title: 'Build the agents', body: 'We design agents around your documents, templates and systems, and test them against your past work.' },
  { title: 'Run it with your experts', body: 'Your team reviews every output. We measure time saved, refine the workflow and keep it running.' },
];

const examples = ['Medical records review', 'Claims files', 'Compliance reviews', 'Intake & triage', 'Contract review', 'Report drafting'];
---

<Base
  title="Tide Technology Solutions"
  description="AI does the reading. Experts do the reasoning. Tide Technology Solutions builds agentic AI products and custom workflows for document-heavy professional work."
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="hero-wash" aria-hidden="true"></div>
    <div class="container-page relative grid gap-14 pt-20 pb-8 sm:pt-28 lg:grid-cols-[1.25fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow">Agentic AI for expert work</p>
        <h1 class="mt-5 text-5xl leading-[1.05] sm:text-6xl lg:text-[4.25rem]">
          AI does the reading.<br />
          <span class="italic text-accent">Experts do the reasoning.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-muted">
          Tide Technology Solutions builds AI products and custom agentic workflows for professionals whose work runs on
          documents. Our agents handle the reading, organizing and first drafts, so your experts spend their time on
          judgment.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-primary">Get in touch</a>
          <a href="#products" class="btn btn-ghost">Our products</a>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1" role="img" aria-label="AI reviews pages, cites facts, flags conflicts and drafts. Experts weigh evidence, form opinions and approve.">
        <div class="rounded-2xl border border-line bg-surface p-6">
          <p class="eyebrow">AI does the reading</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {reading.map((r) => (
              <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-accent"></span>{r}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl bg-deep p-6 text-white">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-white/70">Experts do the reasoning</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {reasoning.map((r) => (
              <li class="flex items-center gap-3"><span class="h-1.5 w-1.5 rounded-full bg-white"></span>{r}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <div class="container-page relative">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-6 text-sm text-muted">
        {trust.map((t) => (
          <li class="flex items-center gap-2">
            <svg viewBox="0 0 16 16" class="h-4 w-4 text-accent" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            {t}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Problem -->
  <section class="container-page mt-24 grid gap-10 md:grid-cols-2 md:items-end">
    <div>
      <p class="eyebrow">The problem</p>
      <h2 class="mt-4 text-4xl sm:text-5xl">Your experts spend most of their day reading.</h2>
    </div>
    <p class="text-lg text-muted">
      In professional services, the expensive part of the job, judgment, sits behind hours of reading, summarizing and
      copying facts between documents. That groundwork is exactly what agentic AI does well, if it is built to be
      checked.
    </p>
  </section>

  <!-- Products -->
  <section id="products" class="container-page mt-24 scroll-mt-24">
    <p class="eyebrow">Products</p>
    <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl">Purpose-built AI for specific professions.</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-[1.4fr_1fr]">
      <a href="/casework" class="group flex flex-col rounded-3xl border border-line bg-surface p-8 transition-colors hover:border-accent">
        <div class="flex items-center justify-between gap-4">
          <h3 class="text-3xl">Casework</h3>
          <span class="rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">Early access</span>
        </div>
        <p class="mt-3 text-muted">
          Agentic document review and report preparation for vocational consultants and law firms. Casework reads the case
          file, organizes the facts with citations and drafts the report for expert review.
        </p>
        <span class="mt-auto pt-6 text-sm font-semibold text-accent">Explore Casework <span class="inline-block transition-transform group-hover:translate-x-1">→</span></span>
      </a>
      <div class="flex flex-col justify-center rounded-3xl border border-dashed border-line p-8">
        <h3 class="text-xl text-muted">More on the way</h3>
        <p class="mt-2 text-sm text-muted">
          We’re building more products for document-heavy professions. Have a workflow in mind?{" "}
          <a href="/contact" class="font-semibold text-accent">Tell us about it.</a>
        </p>
      </div>
    </div>
  </section>

  <!-- Custom -->
  <section id="custom" class="container-page mt-24 scroll-mt-24">
    <div class="grid gap-10 md:grid-cols-2 md:items-end">
      <div>
        <p class="eyebrow">Custom agentic workflows</p>
        <h2 class="mt-4 text-4xl sm:text-5xl">Your process, with agents doing the groundwork.</h2>
      </div>
      <p class="text-lg text-muted">
        If your team reviews documents and produces work from them, we can build an agentic workflow around your
        process, templates and security requirements.
      </p>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {approach.map((s, i) => (
        <li class="rounded-2xl border border-line bg-surface p-6">
          <span class="font-serif text-3xl text-accent">0{i + 1}</span>
          <h3 class="mt-4 text-xl">{s.title}</h3>
          <p class="mt-2 text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
    <ul class="mt-8 flex flex-wrap gap-2">
      {examples.map((e) => <li class="rounded-full border border-line bg-surface px-3 py-1.5 text-sm text-muted">{e}</li>)}
    </ul>
  </section>

  <!-- Principles -->
  <section class="container-page mt-24">
    <p class="eyebrow">How we build</p>
    <h2 class="mt-4 max-w-2xl text-4xl sm:text-5xl">AI you can put your name behind.</h2>
    <div class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2">
      {principles.map((p) => (
        <div class="border-t border-line pt-6">
          <h3 class="text-xl">{p.title}</h3>
          <p class="mt-2 text-muted">{p.body}</p>
        </div>
      ))}
    </div>
    <a href="/security" class="mt-10 inline-block text-sm font-semibold text-accent">Read about security &amp; compliance →</a>
  </section>

  <CTA />
</Base>

<style>
  .hero-wash {
    position: absolute;
    inset: -20% -10% auto;
    height: 80%;
    background:
      radial-gradient(ellipse 50% 60% at 80% 20%, var(--accent-soft), transparent 70%),
      radial-gradient(ellipse 40% 50% at 10% 0%, var(--accent-soft), transparent 70%);
    opacity: 0.9;
  }
</style>
