---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Font } from 'astro:assets';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === 'Tide Technology Solutions' ? title : `${title} | Tide Technology Solutions`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#9e1b32" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tide Technology Solutions" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-inter" preload={[{ weight: "400", style: "normal" }]} />
    <Font cssVariable="--font-fraunces" preload={[{ weight: "400", style: "normal" }]} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Tide Technology Solutions',
      logo: 'https://www.tide-technology.com/tts-logo.svg',
      url: 'https://www.tide-technology.com',
      email: 'brad@tide-technology.com',
      description: 'Custom agentic AI workflows and products that help businesses run more efficiently.',
    })} />

    <script is:inline>
      // Retire the old site's service worker so returning visitors see the new site.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
      }
    </script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn btn-primary">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Temporary layout diagnostics, shown only with ?debug in the URL.
      if (location.search.includes('debug')) {
        const box = document.createElement('pre');
        box.id = 'tt-debug';
        box.style.cssText = 'position:fixed;left:8px;right:8px;top:72px;z-index:99;margin:0;padding:8px;font:11px/1.35 ui-monospace,monospace;white-space:pre-wrap;background:#fffbe6;color:#000;border:2px solid #d00;border-radius:8px;max-height:60vh;overflow:auto';
        document.body.append(box);
        const px = (v) => { const d = document.createElement('div'); d.style.cssText = 'position:absolute;top:0;height:' + v; document.body.append(d); const h = d.offsetHeight; d.remove(); return h; };
        const report = () => {
          const de = document.documentElement, f = document.querySelector('footer');
          const fb = Math.round(f.getBoundingClientRect().bottom + scrollY);
          const vv = window.visualViewport;
          const beyond = [];
          for (const el of document.querySelectorAll('body *')) {
            if (el === box || box.contains(el)) continue;
            const r = el.getBoundingClientRect();
            if (r.height && (r.bottom + scrollY > fb + 1 || r.right > innerWidth + 1)) beyond.push(el.tagName + '.' + String(el.className?.baseVal ?? el.className).slice(0, 30) + ' b=' + Math.round(r.bottom + scrollY) + ' r=' + Math.round(r.right));
          }
          const after = []; let n = f.nextElementSibling; while (n) { if (n !== box) after.push(n.tagName + (n.id ? '#' + n.id : '')); n = n.nextElementSibling; }
          box.textContent = [
            'docScrollH=' + de.scrollHeight + ' docClientH=' + de.clientHeight + ' bodyH=' + Math.round(document.body.getBoundingClientRect().height) + ' footerBottom=' + fb,
            'scrollY=' + Math.round(scrollY) + ' scrollY+innerH=' + Math.round(scrollY + innerHeight) + ' maxScroll=' + (de.scrollHeight - innerHeight),
            'inner=' + innerWidth + 'x' + innerHeight + ' vv=' + (vv ? Math.round(vv.width) + 'x' + Math.round(vv.height) + ' scale=' + vv.scale.toFixed(2) + ' offTop=' + Math.round(vv.offsetTop) : 'n/a') + ' dpr=' + devicePixelRatio,
            'svh=' + px('100svh') + ' dvh=' + px('100dvh') + ' lvh=' + px('100lvh') + ' vh=' + px('100vh'),
            'rootFont=' + getComputedStyle(de).fontSize + ' bodyFont=' + getComputedStyle(document.body).fontSize + ' footerTextFont=' + getComputedStyle(f.querySelector('p.text-sm')).fontSize,
            'beyond footer: ' + (beyond.slice(0, 6).join(' | ') || 'none'),
            'after footer: ' + (after.join(', ') || 'none'),
            navigator.userAgent,
          ].join('\n');
        };
        addEventListener('load', report); addEventListener('scroll', report, { passive: true }); addEventListener('resize', report); setTimeout(report, 1500);
      }
    </script>
  </body>
</html>
